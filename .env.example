# Copy to .env (./sonyftp setup does this). .env is gitignored.

# Where uploaded photos are stored
UPLOAD_DIR="~/Pictures/SonyA7IV"

# Camera login. Leave FTP_PASSWORD empty and setup generates one.
FTP_USER="a7iv"
FTP_PASSWORD=""

PORT=21
PASV_PORTS="50000:50010"

# Port of the OCSP responder the camera queries to verify the server certificate
OCSP_PORT=8022

# Network interface for IP detection (empty = auto, e.g. en0 / wlan0)
IFACE=""
